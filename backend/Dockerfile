# ---------------------------------------------------------------------------
# 영화 리뷰 감성 분석 API 컨테이너 이미지
#
# 빌드 문맥은 backend 폴더입니다.
#   cd backend
#   docker build -t movie-review-api .
#
# 감성 분석 모델은 저장소에 포함되지 않으므로, 빌드 전에
# app/sentiment/model 과 app/sentiment/model_binary 에 모델 파일이
# 준비되어 있어야 합니다.
# ---------------------------------------------------------------------------

FROM python:3.12-slim

# ---------------------------------------------------------------------------
# 실행 환경
#
# PYTHONUNBUFFERED 는 로그가 즉시 출력되도록 합니다.
# 오프라인 설정은 토크나이저를 불러올 때 외부 접속을 시도하지 않도록 합니다.
# ---------------------------------------------------------------------------
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HOME=/tmp/huggingface

WORKDIR /app

# ---------------------------------------------------------------------------
# 의존성 설치
#
# 소스보다 먼저 설치해 두면 코드만 바뀌었을 때 이 단계를 다시 실행하지 않습니다.
# ---------------------------------------------------------------------------
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ---------------------------------------------------------------------------
# 소스와 자료 복사
#
# 모델 파일이 포함되므로 이 단계에서 이미지 용량이 크게 늘어납니다.
# ---------------------------------------------------------------------------
COPY app ./app
COPY data ./data

# ---------------------------------------------------------------------------
# 실행
#
# Cloud Run 은 PORT 환경 변수로 포트를 지정합니다. 기본값은 8080 입니다.
# 셸 형식으로 작성해야 변수가 치환됩니다.
# ---------------------------------------------------------------------------
EXPOSE 8080

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]