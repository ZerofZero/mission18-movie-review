# ---------------------------------------------------------------------------
# 이 파일은 필요한 환경 변수의 목록을 보여주는 예시입니다.
# 실제 값은 같은 위치에 .env 파일을 만들어 입력합니다.
# .env 는 저장소에 커밋되지 않습니다.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 애플리케이션
# ---------------------------------------------------------------------------
APP_NAME=Movie Review Sentiment API
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# 데이터베이스
#
# SQLite 를 사용합니다. 경로는 backend 디렉터리 기준입니다.
# 다른 데이터베이스로 교체할 경우 이 값만 변경하면 됩니다.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./movie_review.db

# 애플리케이션 기동 시 데이터베이스가 비어 있으면 시드 데이터를 삽입합니다.
SEED_ON_STARTUP=true

# ---------------------------------------------------------------------------
# TMDB API
#
# 아래 두 값 중 하나만 설정하면 됩니다.
# TMDB_ACCESS_TOKEN 이 설정되어 있으면 그쪽을 우선 사용합니다.
#
#   TMDB_ACCESS_TOKEN : v4 Read Access Token (eyJ 로 시작하는 긴 문자열)
#   TMDB_API_KEY      : v3 API Key (32자리 16진수)
# ---------------------------------------------------------------------------
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=ko-KR
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# ---------------------------------------------------------------------------
# 관리자 키
#
# 영화 및 리뷰 삭제 요청 시 X-Admin-Key 헤더로 전달해야 하는 값입니다.
# 임의의 긴 문자열을 사용합니다.
# ---------------------------------------------------------------------------
ADMIN_KEY=change-this-to-a-long-random-string

# ---------------------------------------------------------------------------
# 감성 분석 모델
#
# MODEL_DIR   : 모델 파일과 토크나이저가 위치한 디렉터리
# MODEL_FILE  : ONNX 모델 파일명
# MAX_LENGTH  : 토크나이저 최대 입력 길이
# ---------------------------------------------------------------------------
MODEL_DIR=app/sentiment/model
MODEL_FILE=model.onnx
MODEL_MAX_LENGTH=256

# 리뷰 등록 시 요구하는 최소 한글 문자 비율입니다.
KOREAN_RATIO_THRESHOLD=0.3

# ---------------------------------------------------------------------------
# CORS
#
# 허용할 출처를 쉼표로 구분해 입력합니다.
# 개발 단계에서는 * 로 두고, 배포 시 프론트엔드 주소로 제한합니다.
# ---------------------------------------------------------------------------
CORS_ORIGINS=*
